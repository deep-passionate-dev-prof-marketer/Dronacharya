{
  "name": "dronacharya",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && node scripts/ui-debt.mjs",
    "test": "vitest run",
    "test:api": "node scripts/api-smoke.mjs",
    "demo:analytics": "tsx scripts/seed-analytics-demo.ts",
    "ai:models": "mkdir -p data/models && curl -L --fail -o data/models/ggml-base.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.bin && ollama pull ${OLLAMA_MODEL:-qwen2.5:3b}",
    "ai:whisper": "whisper-server -m data/models/ggml-base.bin --host 127.0.0.1 --port 8178 --inference-path /v1/audio/transcriptions -t 4",
    "ai:ollama": "OLLAMA_FLASH_ATTENTION=1 OLLAMA_KV_CACHE_TYPE=q8_0 ollama serve"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "jose": "^6.2.12",
    "lucide-react": "^0.546.0",
    "mediasoup": "^3.27.1",
    "mediasoup-client": "^3.24.1",
    "motion": "^12.23.24",
    "nodemailer": "10.0.13",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "mediasoup@3.27.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
