# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LiveKit (classroom audio/video). Local: run `livekit-server --dev` and use the values below.
# Production: create a project on LiveKit Cloud (or self-host) and paste its URL/key/secret.
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# Sign-in. Dev "sign in as…" with seeded test accounts; MUST be 0 in production.
AUTH_DEV_LOGIN=1
# 32+ random characters; signs session cookies.
SESSION_SECRET="change-me-to-64-random-hex-chars"
# Google Workspace SSO (staff restricted to this domain)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ALLOWED_DOMAIN="21k.school"
# Database: leave empty for the embedded PGlite test DB (data/pglite); Supabase connection string for production.
DATABASE_URL=""

# Desktop app attestation key (same value is baked into the desktop build as DRONACHARYA_APP_KEY)
DESKTOP_APP_KEY="generate-a-long-random-key"
# Optional shared secret for CRM webhooks (sent as X-Webhook-Secret)
CRM_WEBHOOK_SECRET=""
