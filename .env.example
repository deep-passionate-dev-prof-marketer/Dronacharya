# Copy to .env and fill in. Never commit .env.
# Everything runs on the school's own server; nothing here points at an outside service.
# Step-by-step setup: docs/DEPLOY.md

# ---------- Server (docker-compose.yml) ----------
# The site's address. Caddy serves HTTPS for it (camera and microphone only work over HTTPS).
SITE_ADDRESS="classroom.21k.school"
# The same address as a full URL (used in links and emails)
PUBLIC_APP_URL="https://classroom.21k.school"
# Password for the database container (long and random, e.g. `openssl rand -hex 24`)
POSTGRES_PASSWORD=""
# Without Docker: a Postgres connection string. Empty = embedded test database (data/pglite), development only.
# (docker-compose.yml sets this for you.)
DATABASE_URL=""
# CA certificate (PEM; "\n" for newlines) when the database is on another machine over TLS
DATABASE_CA_CERT=""

# ---------- Class video and audio (our own media server) ----------
# The server's public IP address. Browsers send class video to it on UDP (or TCP) ports
# MEDIA_PORT .. MEDIA_PORT + MEDIA_WORKERS - 1, so open those on the firewall.
MEDIA_ANNOUNCED_IP=""
MEDIA_PORT=40000
MEDIA_WORKERS=4                 # one per CPU core is plenty; each uses one port
# 1 = no media server: classes fall back to direct (peer-to-peer) video, no breakout rooms. Testing only.
MEDIA_DISABLED=0
# Optional: your own TURN relay (e.g. coturn on this server) for the direct-video fallback only.
TURN_URLS=""                    # comma-separated, e.g. turns:classroom.21k.school:5349
TURN_USERNAME=""
TURN_CREDENTIAL=""

# ---------- Sign-in ----------
# 32+ random characters; signs session cookies (`openssl rand -hex 32`). Required in production:
# the server refuses to start with a missing, short or example value.
SESSION_SECRET=""
# The first admin account, created on first start. They sign in with this email and password,
# choose a new password, then add everyone else on the People page (each person gets a
# temporary password to change at first sign-in).
# Leave the password empty to have a temporary one printed once in the server log.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
# Optional: the school's own mail server, for sign-in codes by email and parent messages.
# Empty = passwords only; nothing is emailed.
SMTP_URL=""                     # e.g. smtps://user:password@mail.21k.school:465
MAIL_FROM="21K School <no-reply@21k.school>"
# "Sign in as…" test accounts. Development: on (set 0 to hide). Production: keep 0.
# (1 in production only for a staging copy, and then only behind DEV_LOGIN_PASSCODE, 8+ characters.)
AUTH_DEV_LOGIN=0
DEV_LOGIN_PASSCODE=""

# ---------- The school's AI server (optional) ----------
# docker compose --profile ai up -d   starts both below; then: docker compose exec ollama ollama pull qwen2.5:7b
# Without them: notes are extractive (sentences from the transcript), questions are answered by
# quoting the transcript, and live captions are off.
# Language model (Ollama): class notes, "ask about this class", caption translation
OLLAMA_URL=""                   # docker-compose.yml: http://ollama:11434
OLLAMA_MODEL="qwen2.5:7b"       # qwen2.5:3b fits an 8 GB machine
OLLAMA_NUM_CTX=16384            # context window; longer classes are summarised in parts
# Speech-to-text for live captions (any OpenAI-compatible Whisper server: speaches, whisper.cpp)
WHISPER_URL=""                  # docker-compose.yml: http://whisper:8000
WHISPER_MODEL="Systran/faster-whisper-small"

# ---------- Recordings and files ----------
# Classes are kept as transcripts and notes on this server (data/recordings; uploads in data/files).
# Optional: your own S3-compatible storage (e.g. MinIO on this server) instead of local disk.
RECORDING_S3_BUCKET=""
RECORDING_S3_ENDPOINT=""
RECORDING_S3_REGION=""
RECORDING_S3_ACCESS_KEY=""
RECORDING_S3_SECRET=""
# Learners with no recorded decision: "include" (default; parents can opt out in the parent portal) or "exclude"
RECORDING_CONSENT_DEFAULT="include"

# ---------- Features ----------
# Illustrative demo pages and in-class demos (pitch rooms, remote devices, certificates, automation,
# CRM simulator, self-hosting, peer notes). Default: on in development, off in production.
SHOW_DEMO_FEATURES=""
# Content-Security-Policy is report-only until this is 1
CSP_ENFORCE=0
# How long a class keeps running after everyone leaves the video room (host refreshing, network blip)
ROOM_FINISHED_GRACE_MS=120000

# ---------- Desktop app ----------
# Attestation key (same value is baked into the desktop build as DRONACHARYA_APP_KEY)
DESKTOP_APP_KEY="generate-a-long-random-key"
# Installer links shown on /download (https only; host them on this server)
DESKTOP_DOWNLOAD_MAC=""
DESKTOP_DOWNLOAD_WIN=""
DESKTOP_APP_VERSION=""

# ---------- Integrations ----------
# Shared secret for incoming CRM webhooks (sent as X-Webhook-Secret)
CRM_WEBHOOK_SECRET=""
