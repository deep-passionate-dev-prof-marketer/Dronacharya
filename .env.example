# Copy to .env and fill in. Never commit .env.

# ---------- App ----------
# Public address of this server (used for links and as the base of the recording layout page)
PUBLIC_APP_URL="http://localhost:3000"

# ---------- AI: Gemini first, the school's own servers as fallback ----------
# Used for lecture notes, "ask about this class", and server captions (Firefox/Safari, or everyone
# when STT_PREFER_SERVER=1). Providers are tried in AI_PROVIDERS order; one that fails, times out
# or hits its quota is skipped for 2 minutes and the next one takes over (mid-class for captions).
# With no AI at all: notes are extractive (sentences from the transcript) and questions are
# answered by quoting the transcript.
AI_PROVIDERS="gemini,local"     # "local,gemini" or "local" keeps everything on our servers
GEMINI_API_KEY=""
NOTES_MODEL=""                  # optional Gemini model overrides
STT_MODEL=""

# Local language model (Ollama): notes + answers.  npm run ai:ollama  (then: ollama pull qwen2.5:7b)
OLLAMA_URL=""                   # e.g. http://127.0.0.1:11434
OLLAMA_MODEL="qwen2.5:7b"       # qwen2.5:3b fits an 8 GB machine
OLLAMA_NUM_CTX=16384            # context window; longer classes are summarised in parts

# Local speech-to-text (any OpenAI-compatible Whisper server: whisper.cpp, faster-whisper/speaches)
#   npm run ai:whisper   (whisper.cpp; model file in data/models, see npm run ai:models)
WHISPER_URL=""                  # e.g. http://127.0.0.1:8178
WHISPER_MODEL="base"            # the name your server expects (speaches: Systran/faster-whisper-small)
# 1 = transcribe everyone on our servers (no browser speech service, which sends audio to Google/Microsoft)
STT_PREFER_SERVER=0

# ---------- Live video (LiveKit) ----------
# Local: npm run livekit:dev   (runs livekit-server --dev --config livekit.dev.yaml)
# Production: LiveKit Cloud (or self-hosted) URL/key/secret. Point its webhook at
#   https://<your-domain>/api/livekit/webhook
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# ---------- Class recording ----------
# Every class is recorded automatically. Video needs LiveKit Egress (LiveKit Cloud includes it,
# or run the livekit/egress Docker image) → set LIVEKIT_EGRESS=1. Otherwise classes are kept as transcripts.
LIVEKIT_EGRESS=0
# Where videos go. Empty = local disk (data/recordings; Egress writes to EGRESS_OUTPUT_DIR inside its container).
# Supabase Storage (S3-compatible): bucket, https://<project>.supabase.co/storage/v1/s3, region, and S3 access keys.
RECORDING_S3_BUCKET=""
RECORDING_S3_ENDPOINT=""
RECORDING_S3_REGION=""
RECORDING_S3_ACCESS_KEY=""
RECORDING_S3_SECRET=""
EGRESS_OUTPUT_DIR="/out"
# Learners with no recorded decision: "include" (default; parents can opt out in the parent portal) or "exclude"
RECORDING_CONSENT_DEFAULT="include"

# ---------- Sign-in ----------
# Dummy "sign in as…" test accounts. MUST be 0 in production.
AUTH_DEV_LOGIN=1
# 32+ random characters; signs session cookies. Required in production.
SESSION_SECRET="change-me-to-64-random-hex-chars"
# Google Workspace SSO (staff restricted to this domain)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ALLOWED_DOMAIN="21k.school"

# ---------- Database ----------
# Empty = embedded PGlite test database (data/pglite). Production: Supabase Postgres connection string.
DATABASE_URL=""
# Supabase CA certificate (PEM; "\n" for newlines) so the database TLS certificate is verified
DATABASE_CA_CERT=""

# ---------- Desktop app ----------
# Attestation key (same value is baked into the desktop build as DRONACHARYA_APP_KEY)
DESKTOP_APP_KEY="generate-a-long-random-key"
# Installer links shown on /download (https only)
DESKTOP_DOWNLOAD_MAC=""
DESKTOP_DOWNLOAD_WIN=""
DESKTOP_APP_VERSION=""

# ---------- Integrations ----------
# Shared secret for CRM webhooks (sent as X-Webhook-Secret)
CRM_WEBHOOK_SECRET=""
